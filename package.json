{
  "name": "piano-helper",
  "private": true,
  "version": "0.1.0",
  "description": "Piano Helper — local adult piano studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sahil-patel-2011/piano-helper.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @piano-helper/desktop",
    "dev:web": "npm run dev -w @piano-helper/web",
    "build": "npm run build -w @piano-helper/shared && npm run build -w @piano-helper/starters && npm run build -w @piano-helper/bridge && npm run build -w @piano-helper/desktop && npm run build -w @piano-helper/web",
    "build:desktop": "npm run build -w @piano-helper/desktop",
    "build:web": "npm run build -w @piano-helper/web",
    "test": "npm run test -w @piano-helper/shared",
    "piano-helper": "npm run start -w @piano-helper/bridge"
  },
  "allowScripts": {
    "electron@36.9.5": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
